[Unit]
Description=Gated Immich synthetic upload, backup, restore and cleanup
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=8h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=/home/egk/homelab/reliability/monitor
ExecStart=/usr/bin/python3 /home/egk/homelab/reliability/monitor/immich_monitor.py --synthetic
Environment=IMMICH_BACKUP_MAX_AGE_HOURS=2
UMask=0077
NoNewPrivileges=true
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=7h
Restart=on-failure
RestartSec=30min
