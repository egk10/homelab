{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.5.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "2.0.0"}
  ],
  "title": "Ceph - Cluster Overview",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s","10s","15s","30s","1m","5m","15m"]},
  "panels": [
    {
      "type": "stat",
      "title": "Cluster Health",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {"expr": "ceph_health_status", "refId": "A"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["last"], "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "HEALTH_OK"}, "1": {"text": "WARN"}, "2": {"text": "ERROR"}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 2}
          ]}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "OSDs Up / In",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"expr": "sum(ceph_osd_up)", "refId": "A"},
        {"expr": "sum(ceph_osd_in)", "refId": "B"}
      ],
      "options": {"reduceOptions": {"calcs": ["last"], "values": false}},
      "fieldConfig": {"defaults": {"unit": "none"}}
    },
    {
      "type": "stat",
      "title": "PGs by State (active+clean)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum by (state) (ceph_pg_state)", "refId": "A"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "fieldConfig": {"defaults": {"unit": "none"}}
    },
    {
      "type": "gauge",
      "title": "Cluster Capacity Used %",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "(ceph_cluster_total_used_bytes / ceph_cluster_total_bytes) * 100", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {"mode": "percentage", "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 70},
            {"color": "red", "value": 85}
          ]}
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Reads/Writes Ops/s",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "rate(ceph_pool_rd[{__rate_interval}])", "legendFormat": "Pool {{pool}} rd/s", "refId": "A"},
        {"expr": "rate(ceph_pool_wr[{__rate_interval}])", "legendFormat": "Pool {{pool}} wr/s", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Client Throughput (B/s)",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "rate(ceph_client_bytes_read[{__rate_interval}])", "legendFormat": "read", "refId": "A"},
        {"expr": "rate(ceph_client_bytes_written[{__rate_interval}])", "legendFormat": "write", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "type": "table",
      "title": "OSD Status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 11},
      "targets": [
        {"expr": "ceph_osd_up", "legendFormat": "osd {{osd}} up", "refId": "A"},
        {"expr": "ceph_osd_in", "legendFormat": "osd {{osd}} in", "refId": "B"}
      ],
      "options": {"showHeader": true}
    },
    {
      "type": "timeseries",
      "title": "PG States Counts",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 11},
      "targets": [
        {"expr": "sum by (state) (ceph_pg_state)", "legendFormat": "{{state}}", "refId": "A"}
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {"list": [{"builtIn": 1, "type": "dashboard", "name": "Annotations & Alerts", "enable": true}]}
}
